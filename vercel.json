{
  "version": 2,
  "cleanUrls": true,
  "routes": [
    {
      "src": "/api/order",
      "dest": "/api/order"
    },
    {
      "src": "/order",
      "dest": "/api/order"
    },
    {
      "src": "/(.*\\.(css|js|png|jpe?g|gif|svg|webp|ico|avif))",
      "dest": "/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
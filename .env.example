# Copy this file to .env and fill in your SMTP details.
# Email notifications are disabled by default.
# Set ENABLE_EMAIL=true only if you have a valid SMTP account.
# For Gmail, use an App Password and set SMTP_PORT=465.

ENABLE_EMAIL=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@example.com
SMTP_PASS=your-email-password
EMAIL_TO=your-email@example.com
